{
  "schema_version": 1,
  "name": "dsv41tp2",
  "user": "tester",
  "binary": "/opt/rexl3/bin/rexl3-serve",
  "binary_max_ranks": 2,
  "state_dir": "$HOME/.local/share/rexl3/unstarted",
  "ssh": {
    "options": [
      "-F",
      "/dev/null",
      "-o",
      "BatchMode=yes",
      "-o",
      "StrictHostKeyChecking=yes",
      "-o",
      "ForwardAgent=no",
      "-o",
      "ClearAllForwardings=yes",
      "-o",
      "PermitLocalCommand=no",
      "-o",
      "SendEnv=-*",
      "-o",
      "ConnectTimeout=10",
      "-o",
      "ServerAliveInterval=15",
      "-o",
      "ServerAliveCountMax=2"
    ]
  },
  "pack": "/models/dsv41",
  "serve": {
    "flags": [
    "--slots",
    "1",
    "--max-model-len",
    "1048576",
    "--kv-dtype",
    "q4",
      "--no-video",
      "--no-vision",
      "--spec",
      "auto",
      "--prefix-cache",
      "on",
      "--served-model-name",
      "DSV4.1-Flash-1017-SAGE-REXL3-1.55bpw"
    ],
    "env": {
      "REXL3_DSV41_KV": "q4",
      "REXL3_DSV41_FAST_MOE": "1",
      "REXL3_DSV41_SPEC_LEARN": "1",
      "REXL3_DSV41_MOE_TOPP": "1.0"
    }
  },
  "tp": {
    "connect_timeout_s": 300,
    "ready_timeout_s": 900,
    "peer_timeout_s": 60,
    "shutdown_grace_s": 5
  },
  "nccl": {
    "max_nchannels": 4,
    "socket_ifname": "eth0",
    "hca": [
      "mlx5_0:1"
    ],
    "env": {}
  },
  "memory": {
    "_comment": "least MemAvailable a rank needs before the launcher starts it. Without a declared floor the pre-flight fails any host with less than pack/ranks (298.26 GiB / 2 = 149.1 GiB) available, which no GB10 (about 114-118 GiB) has, so the shipped launcher could not start this profile. The rank planner of the 1M window plans 77.4 GiB (rank 0) and 77.6 GiB (rank 1) (event=dsv41_mem_check planned_gib at boot); 80 is that plan rounded up.",
    "min_free_gib": 80
  },
  "lock_wait_s": 1,
  "nodes": [
    {
      "name": "leader",
      "address": "192.0.2.2",
      "fabric_address": "192.0.2.2",
      "user": "tester",
      "local": false,
      "env": {},
      "flags": []
    },
    {
      "name": "follower",
      "address": "192.0.2.3",
      "fabric_address": "192.0.2.3",
      "user": "tester",
      "local": false,
      "env": {},
      "flags": []
    }
  ],
  "groups": [
    {
      "name": "tp2",
      "ranks": [
        "leader",
        "follower"
      ],
      "http_host": "192.0.2.2",
      "http_port": 8940,
      "tp_port": 29600,
      "leader_flags": []
    }
  ]
}
